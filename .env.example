# AI Gateway
# Create a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys&title=AI+Gateway+API+Keys
# Leave this empty to use the built-in local composer (still previews a real page).
AI_GATEWAY_API_KEY=

# Optional provider/model id from https://ai-gateway.vercel.sh/v1/models
# When unset, the server uses google/gemini-3.5-flash.
AI_GATEWAY_MODEL=
